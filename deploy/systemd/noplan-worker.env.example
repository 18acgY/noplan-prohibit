# /etc/noplan-worker.env  （chmod 600）
# 只有 worker 用；网站自己的变量在仓库根的 .env 里。
#
# 路径全部按「一次 clone 拿到网站 + 引擎」写。若你的检出目录不同，
# 只改下面 TA_ 这一组，别处的代码会跟着走。
NOPLAN_API_BASE=http://127.0.0.1:8080
NOPLAN_WORKER_TOKEN=与网站 .env 里的 NOPLAN_WORKER_TOKEN 一致

# 引擎代码（仓库内的 engine/）
TA_REPO=/home/workspace/noplan-prohibit/engine
# 启动器（仓库内的 deploy/tradingagents/）
TA_LAUNCHER=/home/workspace/noplan-prohibit/deploy/tradingagents/relay_launcher.py
# 引擎的 Python 环境（scripts/setup-engine.sh 建出来的）
TA_PYTHON=/home/workspace/noplan-prohibit/engine/.venv/bin/python

# 运行时数据：记忆 + 报告 + 缓存。**必须显式写**，且必须在仓库之外，
# 否则数据会写进仓库、或者静默换到一个空记忆文件（不报错，只是「每次分析都像第一次」）。
TA_DATA=/home/workspace/tradingagents/.runtime

TA_ANALYSTS=market,news,fundamentals
# 冒烟实测 8 分 51 秒，断流重试要留时间预算，故 30 分钟
TA_TIMEOUT_MIN=30
TA_POLL_SEC=5
TA_HEARTBEAT_SEC=30
# 取消标记查询间隔（秒）
TA_CANCEL_POLL_SEC=5