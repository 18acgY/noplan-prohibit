# /etc/noplan-worker.env  （chmod 600）
NOPLAN_API_BASE=http://127.0.0.1:8080
NOPLAN_WORKER_TOKEN=与网站 .env 里的 NOPLAN_WORKER_TOKEN 一致
TA_REPO=/home/workspace/tradingagents/TradingAgents
TA_DATA=/home/workspace/tradingagents/.runtime
TA_LAUNCHER=/home/workspace/tradingagents/relay_launcher.py
TA_PYTHON=/home/workspace/tradingagents/TradingAgents/.venv/bin/python
TA_ANALYSTS=market,news,fundamentals
# 冒烟实测 8 分 51 秒；留 2 倍余量
TA_TIMEOUT_MIN=20
TA_POLL_SEC=5
TA_HEARTBEAT_SEC=30
# 取消标记查询间隔（秒）
TA_CANCEL_POLL_SEC=5