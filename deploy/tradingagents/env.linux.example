# Linux 版配置样例：复制为 TradingAgents/.env 后填写真实 key，并 chmod 600
# 路径按服务器约定：引擎在 /home/workspace/TradingAgents，运行数据在 /home/workspace/.runtime
OPENAI_COMPATIBLE_API_KEY=sk-在这里填你的 relay key
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=https://api.cingsi.xyz/v1
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4.1-flash
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4.1-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_NO_UPDATE_CHECK=1
TRADINGAGENTS_RESULTS_DIR=/home/workspace/.runtime/logs
TRADINGAGENTS_CACHE_DIR=/home/workspace/.runtime/cache
TRADINGAGENTS_MEMORY_LOG_PATH=/home/workspace/.runtime/memory/trading_memory.md